def _run_selftests():
    import unittest

    class CoreTests(unittest.TestCase):
        def test_contador_bytes(self):
            buf = b"ABCD\x00EFG"
            self.assertEqual(contador_bytes(buf, 0, len(buf)), 4)
            self.assertEqual(contador_bytes(buf, 5, len(buf)), 0)
            self.assertEqual(contador_bytes(buf, 6, len(buf)), 2)

        def test_load_table_fallback(self):
            b2c, c2b = load_table("__arquivo_que_nao_existe__.tbl")
            # Deve mapear espaço e {00}
            self.assertEqual(b2c.get(0x20), ' ')
            self.assertEqual(b2c.get(0x00), '{00}')
            self.assertEqual(c2b.get(' '), 0x20)

        def test_update_log_safe(self):
            # Não deve lançar mesmo com widget None
            update_log(None, "teste")

    suite = unittest.defaultTestLoader.loadTestsFromTestCase(CoreTests)
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)
    return 0 if result.wasSuccessful() else 1


