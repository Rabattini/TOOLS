class UnifiedApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Ferramentas de ROM - Pacotes & Textos")
        self.minsize(980, 700)
        self._apply_style()
        self._build_ui()

    def _apply_style(self):
        style = ttk.Style(self)
        # Escolhe tema "clam" por padrão (mais moderno que classic/default)
        try:
            style.theme_use('clam')
        except Exception:
            pass
        style.configure('TButton', padding=6)
        style.configure('TLabel', padding=2)
        style.configure('TLabelframe', padding=8)
        style.configure('TLabelframe.Label', font=('Segoe UI', 10, 'bold'))

    def _build_ui(self):
        nb = ttk.Notebook(self)
        nb.pack(fill=tk.BOTH, expand=True)

        self.pack_tab = PackTab(nb)
        self.text_tab = TextTab(nb)
        nb.add(self.pack_tab, text='Pacotes')
        nb.add(self.text_tab, text='Textos')

        # Barra inferior simples com troca de tema
        bar = ttk.Frame(self)
        bar.pack(fill=tk.X, side=tk.BOTTOM)
        ttk.Label(bar, text="Tema:").pack(side=tk.LEFT, padx=(6,2))
        theme_var = tk.StringVar(value=ttk.Style().theme_use())
        themes = ttk.Style().theme_names()
        cmb = ttk.Combobox(bar, values=themes, textvariable=theme_var, state='readonly', width=14)
        cmb.pack(side=tk.LEFT, padx=(0,6))
        def set_theme(*_):
            try:
                ttk.Style().theme_use(theme_var.get())
            except Exception:
                pass
        cmb.bind('<<ComboboxSelected>>', set_theme)

        ttk.Separator(bar, orient=tk.VERTICAL).pack(side=tk.LEFT, fill=tk.Y, padx=8)
        ttk.Label(bar, text="Dica: use a aba Textos para editar e inserir direto no .msg").pack(side=tk.LEFT)


